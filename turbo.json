{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@adminium/desktop#build": {
      "dependsOn": [
        "@adminium/dashboard#build",
        "@adminium/server#build",
        "^build"
      ],
      "outputs": [
        "out/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TEST_*",
        "ADMINIUM_TEST_*"
      ]
    },
    "e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "CI",
        "E2E_*",
        "TEST_*",
        "PLAYWRIGHT_*"
      ]
    }
  }
}
