{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@adminium/config#build": {
      "outputs": []
    },
    "@adminium/desktop#build": {
      "dependsOn": [
        "@adminium/dashboard#build",
        "@adminium/server#build",
        "^build"
      ],
      "outputs": [
        "out/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@adminium/docs#typecheck": {
      "dependsOn": [
        "@adminium/docs#build",
        "^build"
      ]
    },
    "@adminium/docs#lint": {
      "dependsOn": [
        "@adminium/docs#typecheck"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TEST_*",
        "ADMINIUM_TEST_*",
        "PGUSER",
        "PGPASSWORD"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "CI",
        "E2E_*",
        "TEST_*",
        "PLAYWRIGHT_*"
      ]
    },
    "@adminium/e2e#e2e:desktop": {
      "dependsOn": [
        "@adminium/desktop#build"
      ],
      "cache": false,
      "env": [
        "CI",
        "E2E_*",
        "PLAYWRIGHT_*",
        "ADMINIUM_DISABLE_UPDATES"
      ]
    },
    "vrt": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
