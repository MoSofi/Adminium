{
  "name": "@adminium/e2e",
  "version": "0.3.76",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Playwright e2e matrix: built server + built dashboard on sqlite / postgres / mysql, seeded Northwind demo data",
  "scripts": {
    "e2e": "playwright test",
    "e2e:server": "node scripts/e2e-server.mjs",
    "e2e:desktop": "playwright test --config playwright.desktop.config.ts",
    "e2e:chat": "playwright test --config playwright.chat.config.ts",
    "e2e:chat-staff": "playwright test --config playwright.chat-staff.config.ts",
    "e2e:landing": "playwright test --config playwright.landing.config.ts",
    "e2e:company-record": "playwright test --config playwright.company-record.config.ts",
    "e2e:lead-finder": "playwright test --config playwright.lead-finder.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint tests tests-desktop playwright.config.ts playwright.desktop.config.ts playwright.chat.config.ts playwright.chat-staff.config.ts playwright.landing.config.ts playwright.company-record.config.ts playwright.lead-finder.config.ts"
  },
  "devDependencies": {
    "@adminium/adapter-mysql": "workspace:*",
    "@adminium/adapter-postgres": "workspace:*",
    "@adminium/adapter-sqlite": "workspace:*",
    "@adminium/config": "workspace:*",
    "@adminium/dashboard": "workspace:*",
    "@adminium/engine": "workspace:*",
    "@adminium/llm": "workspace:*",
    "@adminium/meta": "workspace:*",
    "@adminium/server": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "22.20.5",
    "better-sqlite3": "^13.2.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.0",
    "eslint": "catalog:",
    "mailparser": "^3.15.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "smtp-server": "^3.21.7",
    "typescript": "catalog:"
  }
}
