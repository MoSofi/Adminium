/*
 * The staff side of __NAME__.
 *
 * It runs inside Adminium, as the person who is signed in: `useStaff()` gives
 * a session that reads and writes the app's tables with that person's own
 * permissions. There is no key and no second sign-in.
 *
 * Open it with `?demo` in the address (or straight from the file) to see it
 * on the sample rows in seeds/sample.json, held in memory, with no Adminium.
 */
import { useCallback, useEffect, useState, type FormEvent } from 'react';
import { APP_NAME, en, sampleRows, useStaff, type Row, type StaffSession } from '@adminiumjs/adminium/side';

import sample from '../../seeds/sample.json';

/** The table's short name: the `ref` of manifest/tables/items.json. */
const ITEMS = 'items';

export function App() {
  const loaded = useStaff({ demo: sampleRows(sample) });
  if (loaded.state === 'loading') return <p className="page muted">{en('Loading…')}</p>;
  if (loaded.state === 'error') return <p className="page notice error">{loaded.message}</p>;
  return <Items staff={loaded.value} />;
}

function Items({ staff }: { staff: StaffSession }) {
  const [rows, setRows] = useState<Row[]>([]);
  const [title, setTitle] = useState('');
  const [problem, setProblem] = useState<string | null>(null);

  const load = useCallback(async () => {
    try {
      setRows((await staff.list(ITEMS, { order: 'id.desc' })).rows);
      setProblem(null);
    } catch (error) {
      setProblem(error instanceof Error ? error.message : String(error));
    }
  }, [staff]);

  useEffect(() => {
    void load();
  }, [load]);

  async function add(event: FormEvent) {
    event.preventDefault();
    if (title.trim() === '') return;
    try {
      await staff.create(ITEMS, { title: title.trim() });
      setTitle('');
      await load();
    } catch (error) {
      setProblem(error instanceof Error ? error.message : String(error));
    }
  }

  async function setStatus(row: Row, status: string) {
    try {
      await staff.update(ITEMS, row['id'] as number, { status });
      await load();
    } catch (error) {
      setProblem(error instanceof Error ? error.message : String(error));
    }
  }

  // The operator's own name for the app when they set one, else the name in the app's manifest.
  const name = staff.appName ?? (APP_NAME || en('__NAME__'));
  const open = rows.filter((row) => row['status'] !== 'done').length;

  // The parts (page, toolbar, list, badge, empty) are in app.css; the colours and type in theme.css.
  return (
    <div className="page">
      <header className="site-header">
        <div className="brand">
          <span className="brand-mark" aria-hidden="true">
            {name.slice(0, 1).toUpperCase()}
          </span>
          {name}
        </div>
        <span className="badge accent">
          {open} {en('open')}
        </span>
      </header>

      {staff.mode === 'demo' ? <p className="notice">{en('Sample data. Nothing here is saved.')}</p> : null}
      {staff.timezoneIsFallback && staff.mode === 'hosted' ? (
        <p className="notice">{en('This database has no time zone set, so times are shown in UTC.')}</p>
      ) : null}
      {problem === null ? null : (
        <p className="notice error" role="alert">
          {problem}
        </p>
      )}

      <main>
        {staff.can(ITEMS, 'create') ? (
          <form className="toolbar" onSubmit={add}>
            <div className="field">
              <label htmlFor="title">{en('New item')}</label>
              <input id="title" value={title} maxLength={120} onChange={(event) => setTitle(event.target.value)} />
            </div>
            <button type="submit" className="btn btn-primary">
              {en('Add')}
            </button>
          </form>
        ) : null}

        {rows.length === 0 ? (
          <div className="empty">
            <strong>{en('Nothing here yet')}</strong>
            <span>{en('What comes in shows here.')}</span>
          </div>
        ) : (
          <ul className="list">
            {rows.map((row) => (
              <li className="list-row" key={String(row['id'])}>
                <div className="row">
                  <span className={row['status'] === 'done' ? 'badge good' : 'badge accent'}>{row['status'] === 'done' ? en('Done') : en('Open')}</span>
                  <span className={row['status'] === 'done' ? 'done' : undefined}>{String(row['title'] ?? '')}</span>
                </div>
                {staff.can(ITEMS, 'update') ? (
                  <button type="button" className="btn btn-small" onClick={() => void setStatus(row, row['status'] === 'done' ? 'open' : 'done')}>
                    {row['status'] === 'done' ? en('Reopen') : en('Mark done')}
                  </button>
                ) : null}
              </li>
            ))}
          </ul>
        )}
      </main>
    </div>
  );
}
