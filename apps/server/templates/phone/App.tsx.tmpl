  markText: { color: '#ffffff', fontWeight: '700' },
  title: { fontSize: 17, fontWeight: '700', color: ink },
  tabs: { flexDirection: 'row', borderTopWidth: 1, borderTopColor: line, backgroundColor: '#ffffff' },
  tab: { flex: 1, alignItems: 'center', paddingVertical: 14, minHeight: 48 },
  tabText: { fontSize: 14, color: quiet, fontWeight: '600' },
  tabSelected: { color: accent },
  list: { padding: 20, gap: 12 },
  hero: { gap: 8, marginBottom: 8 },
  eyebrow: { fontSize: 12, fontWeight: '700', letterSpacing: 1, textTransform: 'uppercase', color: accent },
  heading: { fontSize: 26, fontWeight: '800', color: ink },
  lead: { fontSize: 16, lineHeight: 23, color: quiet },
  card: { padding: 16, borderRadius: 14, borderWidth: 1, borderColor: line, backgroundColor: '#ffffff', gap: 4 },
  cardTitle: { fontSize: 16, fontWeight: '600', color: ink },
  muted: { fontSize: 14, color: quiet },
  form: { padding: 20, gap: 12 },
  label: { fontSize: 14, fontWeight: '600', color: ink },
  input: { minHeight: 120, padding: 12, borderRadius: 12, borderWidth: 1, borderColor: line, backgroundColor: '#ffffff', fontSize: 16, color: ink, textAlignVertical: 'top' },
  button: { alignSelf: 'flex-start', minHeight: 48, paddingHorizontal: 20, borderRadius: 12, backgroundColor: accent, alignItems: 'center', justifyContent: 'center' },
  buttonOff: { opacity: 0.5 },
  buttonText: { color: '#ffffff', fontSize: 16, fontWeight: '700' },
  notice: { padding: 12, borderRadius: 10, fontSize: 14 },
  error: { backgroundColor: '#fdecec', color: '#8a1c1c' },
  good: { backgroundColor: '#e9f7ee', color: '#125c2c' },
});
