    "fastify-type-provider-zod": "^5.0.0 || ^6.0.0",
    "pino": "^9.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@types/node": "22.15.3",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "^13.0.0",
    "vitest": "catalog:"
  }
