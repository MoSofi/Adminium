{
  "name": "@adminium/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "apps/server"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "Fastify server: REST /api/v1, auth, jobs, serves the dashboard build",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "adminium": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "dashboard",
    "vocabulary",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "bundle:dashboard": "node scripts/bundle-dashboard.mjs",
    "bundle:allowlists": "node scripts/bundle-allowlists.mjs",
    "prepack": "node scripts/bundle-dashboard.mjs && node scripts/bundle-allowlists.mjs",
    "demo:m2": "node scripts/demo-m2.mjs"
  },
  "dependencies": {
    "@adminium/adapter-mysql": "workspace:*",
    "@adminium/adapter-postgres": "workspace:*",
    "@adminium/adapter-sqlite": "workspace:*",
    "@adminium/engine": "workspace:*",
    "@adminium/llm": "workspace:*",
    "@adminium/meta": "workspace:*",
    "@adminium/schema-import": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0 || ^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.0.2",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.2.0",
    "croner": "^9.1.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^5.0.0 || ^6.0.0",
    "fflate": "^0.8.3",
    "kysely": "^0.28.2",
    "otpauth": "^9.4.0",
    "pino": "^9.7.0",
    "zod": "catalog:"
  },
  "//optionalDependencies": [
    "The META-STORE drivers (07-meta-store.md; 01-architecture.md \u00a74.2).",
    "src/meta/store.ts opens the meta store with a bare `await import('pg')` /",
    "`import('mysql2')`. They are declared HERE, on the server, and not merely",
    "reached through @adminium/adapter-postgres / -mysql, because a bare",
    "specifier resolves against the IMPORTING package's node_modules: the",
    "Dockerfile's `pnpm deploy --filter=@adminium/server --prod` produces an",
    "isolated tree where an adapter's own dependency lands under .pnpm and is",
    "unreachable from /app/dist. Without these the published image can run only",
    "the embedded SQLite fallback that \u00a73.1 tells people not to use in",
    "production, while docker-compose.yml documents a postgres meta store \u2014 a",
    "crash-loop under `restart: unless-stopped`, with the printed remedy",
    "(`npm install pg`) impossible inside a non-root image.",
    "OPTIONAL, not required: both are pure JS so they always install in",
    "practice, but `--no-optional` stays a supported way to ship a SQLite-only",
    "install, and MetaDriverMissingError still explains that case."
  ],
  "optionalDependencies": {
    "mysql2": "^3.15.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.15.3",
    "@types/ws": "^8.18.1",
    "eslint": "catalog:",
    "pino-pretty": "^13.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  }
}
