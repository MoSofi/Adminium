{
  "name": "adminium-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@adminium/dashboard... --filter=@adminium/server",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "check-deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check-offline-assets": "node scripts/check-offline-assets.mjs",
    "i18n-check": "pnpm --filter @adminium/i18n i18n:check",
    "generate-notices": "node scripts/generate-notices.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "dependency-cruiser": "^18.2.0",
    "turbo": "^2.10.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher",
      "argon2"
    ],
    "overrides": {
      "fast-uri@3": ">=3.1.4",
      "fast-uri@4": ">=4.1.2"
    }
  }
}
