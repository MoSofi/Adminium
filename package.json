{
  "name": "adminium-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@adminium/dashboard... --filter=@adminium/server",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "preflight": "node scripts/preflight.mjs",
    "check-deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check-offline-assets": "node scripts/check-offline-assets.mjs",
    "check-email-block-vocab": "node scripts/check-email-block-vocab.mjs",
    "check-invoice-block-vocab": "node scripts/check-invoice-block-vocab.mjs",
    "check-invoice-money-fixture": "node scripts/check-invoice-money-fixture.mjs",
    "check-spdx": "node scripts/check-spdx.mjs",
    "check-tailwind-utilities": "node scripts/check-tailwind-utilities.mjs",
    "openapi": "pnpm --filter @adminium/server run openapi",
    "openapi-check": "pnpm --filter @adminium/server run openapi:check",
    "ir-schema": "pnpm --filter @adminium/engine run ir-schema",
    "ir-schema-check": "pnpm --filter @adminium/engine run ir-schema:check",
    "rest-api-docs": "pnpm --filter @adminium/docs run rest-api",
    "rest-api-docs-check": "pnpm --filter @adminium/docs run rest-api:check",
    "icon-core": "node scripts/gen-icon-core.mjs",
    "icon-core-check": "node scripts/gen-icon-core.mjs --check",
    "i18n-check": "pnpm --filter @adminium/i18n i18n:check",
    "a11y-keys-check": "node packages/i18n/scripts/gen-a11y-keys.mjs --check",
    "cross-package-tests-check": "node scripts/check-cross-package-tests.mjs --phase=source",
    "cross-package-dist-tests-check": "node scripts/check-cross-package-tests.mjs --phase=dist",
    "generate-notices": "node scripts/generate-notices.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "^18.2.0",
    "turbo": "^2.10.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher",
      "argon2"
    ],
    "overrides": {
      "fast-uri@3": ">=4.1.3",
      "fast-uri@4": ">=4.1.3",
      "js-yaml@4": "^4.3.2"
    }
  }
}
