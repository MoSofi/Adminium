{
  "name": "@adminium/i18n",
  "version": "0.2.2-rc.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "8 locale bundles, ICU messages, RTL utils, Intl formatters",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./registry": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./editing": {
      "types": "./dist/editing.d.ts",
      "default": "./dist/editing.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "default": "./dist/resources/index.js"
    },
    "./locales/*": "./locales/*"
  },
  "scripts": {
    "gen:resources": "node scripts/gen-resources.mjs",
    "gen:a11y-keys": "node scripts/gen-a11y-keys.mjs",
    "i18n:meta": "node scripts/meta.mjs report",
    "i18n:check": "node scripts/meta.mjs check",
    "i18n:review": "node scripts/meta.mjs review",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "intl-messageformat": "^11.2.13"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "eslint": "catalog:",
    "happy-dom": "^18.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "locales"
  ]
}
