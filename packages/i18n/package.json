{
  "name": "@adminium/i18n",
  "version": "0.1.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "8 locale bundles, ICU messages, RTL utils, Intl formatters",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./registry": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "default": "./dist/resources/index.js"
    },
    "./locales/*": "./locales/*"
  },
  "scripts": {
    "gen:resources": "node scripts/gen-resources.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^25.3.2",
    "intl-messageformat": "^10.7.16"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "eslint": "catalog:",
    "happy-dom": "^18.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "locales"
  ]
}
