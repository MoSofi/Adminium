{
  "name": "@adminium/tokens",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "Design tokens: CSS custom properties, accent palettes, density axis, viz palette, fonts, motion, Tailwind v4 theme mapping",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pre-hydration": {
      "types": "./dist/pre-hydration.d.ts",
      "default": "./dist/pre-hydration.js"
    },
    "./index.css": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./accents.css": "./src/accents.css",
    "./density.css": "./src/density.css",
    "./viz.css": "./src/viz.css",
    "./fonts.css": "./src/fonts.css",
    "./motion.css": "./src/motion.css",
    "./exceptions.css": "./src/exceptions.css",
    "./tailwind.css": "./src/tailwind.css",
    "./fonts/*": "./src/fonts/*"
  },
  "files": [
    "dist",
    "src",
    "LICENSES"
  ],
  "scripts": {
    "build": "node scripts/copy-fonts.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "contrast": "node scripts/contrast-check.mjs --strict",
    "test": "pnpm run contrast && vitest run"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
