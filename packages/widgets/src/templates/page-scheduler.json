{
  "id": "page-scheduler",
  "version": 1,
  "titleKey": "templates.scheduler.title",
  "slots": [
    { "slot": "kpi-row", "accepts": { "shapes": ["metric+delta", "single-metric"] },
      "area": { "x": 0, "y": 0, "w": 3, "h": 3 }, "repeat": { "max": 4, "flow": "row" } },
    { "slot": "schedule", "accepts": { "widgets": ["schedule-matrix", "capacity-board"] },
      "area": { "x": 0, "y": 3, "w": 12, "h": 14 }, "required": true },
    { "slot": "insights", "accepts": { "widgets": ["auto-insights"] },
      "area": { "x": 0, "y": 17, "w": 6, "h": 4 }, "fallback": "omit" }
  ],
  "chrome": {
    "toolbar": ["date-range-picker", "filter-chip-bar"],
    "overlays": ["modal-wizard", "toast-stack"]
  }
}
