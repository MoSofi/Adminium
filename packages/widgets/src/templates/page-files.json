{
  "id": "page-files",
  "version": 1,
  "titleKey": "templates.files.title",
  "slots": [
    { "slot": "smart-folders", "accepts": { "shapes": ["hierarchy/tree"], "widgets": ["link-list"] },
      "area": { "x": 0, "y": 0, "w": 3, "h": 12 } },
    { "slot": "browser", "accepts": { "widgets": ["file-browser"] },
      "area": { "x": 3, "y": 0, "w": 9, "h": 12 }, "required": true },
    { "slot": "usage", "accepts": { "widgets": ["usage-meter"] },
      "area": { "x": 0, "y": 12, "w": 3, "h": 3 } },
    { "slot": "upload", "accepts": { "widgets": ["upload-dropzone", "upload-progress-list"] },
      "area": { "x": 3, "y": 12, "w": 9, "h": 4 } }
  ],
  "chrome": { "toolbar": ["breadcrumb"], "overlays": ["toast-stack"] }
}
