{
  "name": "@adminium/widgets",
  "version": "0.3.31",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/widgets"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "Widget registry, page templates, dashboard grid",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page-config": {
      "types": "./dist/page-config/index.d.ts",
      "default": "./dist/page-config/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "default": "./dist/generate/index.js"
    },
    "./binding": {
      "types": "./dist/binding/index.d.ts",
      "default": "./dist/binding/index.js"
    },
    "./kit-board": {
      "types": "./dist/kit-board.d.ts",
      "default": "./dist/kit-board.js"
    },
    "./kit-import": {
      "types": "./dist/kit-import.d.ts",
      "default": "./dist/kit-import.js"
    },
    "./kit-map": {
      "types": "./dist/kit-map.d.ts",
      "default": "./dist/kit-map.js"
    },
    "./people-source": {
      "types": "./dist/families/forms/people-source.d.ts",
      "default": "./dist/families/forms/people-source.js"
    },
    "./mentions": {
      "types": "./dist/mentions.d.ts",
      "default": "./dist/mentions.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@adminium/charts": "workspace:*",
    "@adminium/i18n": "workspace:*",
    "@adminium/tokens": "workspace:*",
    "@adminium/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.525.0",
    "maplibre-gl": "6.11.2",
    "react": "^19.2.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "catalog:",
    "happy-dom": "^18.0.1",
    "react-dom": "^19.2.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
