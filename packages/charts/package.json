{
  "name": "@adminium/charts",
  "version": "0.1.2",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/charts"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "SVG chart primitives (d3-scale/d3-shape math only)",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@adminium/i18n": "workspace:*",
    "@adminium/tokens": "workspace:*",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "catalog:",
    "happy-dom": "^18.0.1",
    "react-dom": "^19.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "src/styles.css"
  ]
}
