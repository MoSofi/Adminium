{
  "name": "@adminium/ui",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/ui"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "Component library (Tiers 1-3), Radix-based, CVA variants, ThemeProvider",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "gen:barrel": "node scripts/gen-barrel.mjs",
    "build": "node scripts/gen-barrel.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/gen-barrel.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "a11y": "node scripts/a11y-sweep.mjs",
    "vrt": "playwright test -c playwright.config.ts",
    "vrt:update": "playwright test -c playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@adminium/tokens": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "catalog:",
    "happy-dom": "^20.11.2",
    "storybook": "^9.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^7.0.5",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
