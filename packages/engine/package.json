{
  "name": "@adminium/engine",
  "version": "0.2.5",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/engine"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "SchemaModel, Adapter interface, classification, config generation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-schema/index.d.ts",
      "default": "./dist/config-schema/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./ir-v1.schema.json": "./ir-v1.schema.json"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "ir-schema": "node scripts/ir-json-schema.mjs",
    "ir-schema:check": "node scripts/ir-json-schema.mjs --check"
  },
  "dependencies": {
    "@adminium/widgets": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "ir-v1.schema.json"
  ]
}
