{
  "kind": "add-on",
  "manifestVersion": 1,
  "key": "shipping-dhl",
  "name": "DHL Shipping",
  "version": "1.0.7",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "addon.shipping-dhl.line",
    "fallback": "Books a parcel collection from a job that is ready, and brings back a label and a tracking reference."
  },
  "categories": ["delivery"],
  "compatibility": {
    "minAdminiumVersion": "0.3.1",
    "requires": ["outbound-http", "file-storage"]
  },
  "capabilities": ["outbound-http", "file-storage"],
  "addOn": {
    "attaches": [
      { "app": "printing", "range": "^0.1.0" },
      { "app": "maker", "range": "^0.1.0" },
      { "app": "factory", "range": "^0.1.0" },
      { "app": "ecommerce-shop", "range": "^0.1.0" },
      { "app": "helpdesk", "range": "^0.1.0" }
    ],
    "provides": [
      { "contract": "shipping-carrier", "version": 1, "server": "dist/server.js" }
    ],
    "consumes": [],
    "slots": [
      { "slot": "order.dispatch.actions", "client": "dist/client.js", "order": 10 },
      { "slot": "checkout.delivery.methods", "client": "dist/client.js", "order": 10 },
      { "slot": "order.dispatch.panel", "client": "dist/client.js", "order": 10 },
      { "slot": "settings.add-on.panel", "client": "dist/client.js", "order": 10 },
      { "slot": "record.actions", "client": "dist/client.js", "order": 10 }
    ],
    "events": [],
    "connect": { "kind": "api-key" },
    "scopes": ["records:shipments:write", "files:write"],
    "network": { "allow": ["express.api.dhl.com"] },
    "publicSettings": [
      "demo_transport",
      "collection_cutoff",
      "returns_name",
      "returns_lines",
      "returns_city",
      "returns_postcode",
      "returns_country"
    ],
    "demoTransport": "dist/server.js"
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "shipments",
        "columns": [
          { "ref": "id", "type": "id", "role": "pk" },
          { "ref": "order_reference", "type": "text" },
          { "ref": "carrier", "type": "text" },
          { "ref": "service", "type": "text" },
          { "ref": "tracking", "type": "text" },
          { "ref": "label_file", "type": "text", "nullable": true },
          { "ref": "amount", "type": "money", "semantic": "money" },
          { "ref": "currency", "type": "text" },
          { "ref": "collection_from", "type": "timestamptz" },
          { "ref": "collection_to", "type": "timestamptz" },
          {
            "ref": "status",
            "type": "enum",
            "enum": ["booked", "collected", "in-transit", "delivered", "cancelled", "refused"]
          },
          { "ref": "created_at", "type": "timestamptz", "role": "created_at" }
        ]
      },
      {
        "ref": "shipment_events",
        "columns": [
          { "ref": "id", "type": "id", "role": "pk" },
          { "ref": "shipment_id", "type": "fk", "references": "shipments" },
          { "ref": "at", "type": "timestamptz" },
          { "ref": "place", "type": "text" },
          { "ref": "status", "type": "text" },
          { "ref": "description", "type": "text" }
        ]
      }
    ]
  },
  "settings": [
    {
      "key": "api_key",
      "type": "string",
      "secret": true,
      "label": {
        "key": "addon.shipping-dhl.setting.apiKey",
        "fallback": "API key"
      }
    },
    {
      "key": "account_number",
      "type": "string",
      "secret": true,
      "label": {
        "key": "addon.shipping-dhl.setting.accountNumber",
        "fallback": "Account number"
      }
    },
    {
      "key": "demo_transport",
      "type": "boolean",
      "default": true,
      "label": {
        "key": "addon.shipping-dhl.setting.demo",
        "fallback": "Use the demo carrier instead"
      }
    },
    {
      "key": "collection_cutoff",
      "type": "string",
      "default": "15:00",
      "label": {
        "key": "addon.shipping-dhl.setting.cutoff",
        "fallback": "Collection cut-off"
      }
    },
    {
      "key": "returns_name",
      "type": "string",
      "default": "",
      "label": {
        "key": "addon.shipping-dhl.setting.returnsName",
        "fallback": "Returns address — name on the label"
      }
    },
    {
      "key": "returns_lines",
      "type": "string",
      "default": "",
      "label": {
        "key": "addon.shipping-dhl.setting.returnsLines",
        "fallback": "Returns address — street"
      }
    },
    {
      "key": "returns_city",
      "type": "string",
      "default": "",
      "label": {
        "key": "addon.shipping-dhl.setting.returnsCity",
        "fallback": "Returns address — town or city"
      }
    },
    {
      "key": "returns_postcode",
      "type": "string",
      "default": "",
      "label": {
        "key": "addon.shipping-dhl.setting.returnsPostcode",
        "fallback": "Returns address — postcode"
      }
    },
    {
      "key": "returns_country",
      "type": "string",
      "default": "",
      "label": {
        "key": "addon.shipping-dhl.setting.returnsCountry",
        "fallback": "Returns address — country"
      }
    }
  ]
}
