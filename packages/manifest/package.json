{
  "name": "@adminium/manifest",
  "version": "0.2.5",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoSofi/Adminium.git",
    "directory": "packages/manifest"
  },
  "homepage": "https://adminium.dev",
  "bugs": "https://github.com/MoSofi/Adminium/issues",
  "type": "module",
  "description": "Micro-SaaS manifest JSON schema, validator, installer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@adminium/add-on-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@adminium/config": "workspace:*",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
