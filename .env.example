# Local development environment for `pnpm dev`.
#
# Copy to `.env` (gitignored) and fill in. The API server's dev watcher reads
# this file via `node --env-file-if-exists`, so it is optional — if you set
# these in your shell instead, or do not run the server, nothing here is needed.
#
# Production does NOT read this file. Self-hosted deployments pass the same
# variables through the environment; see the self-hosting docs for the full set.

# REQUIRED to start the server. Derives the key that encrypts every stored
# database DSN and API key, so it must stay STABLE — changing it makes anything
# already stored undecryptable. Generate once with:
#   openssl rand -hex 32
ADMINIUM_SECRET=

# Where the meta-store (SQLite by default), uploads and exports live. Defaults
# to a platform data directory; point it somewhere disposable for local work.
ADMINIUM_DATA_DIR=

# Port the API listens on. The dashboard's Vite dev server proxies /api and /ws
# here (apps/dashboard/vite.config.ts), so changing it means setting
# ADMINIUM_DEV_API to match.
PORT=4600

# Optional: where uploaded and generated FILES live. Unset means this server's
# own disk, `<ADMINIUM_DATA_DIR>/files`, which is right for local work and for
# any host with a volume. Seeded ONCE, on a boot with no storage destination
# configured; Studio → Storage owns it after that.
#
#   ADMINIUM_STORAGE_URL=s3://my-bucket?endpoint=http://127.0.0.1:9000&region=us-east-1&accessKey=minioadmin&secretKey=minioadmin&pathStyle=1
#   ADMINIUM_STORAGE_URL=webdavs://user:pass@nas.example.com/remote.php/dav/files/user
#   ADMINIUM_STORAGE_URL=file:///srv/adminium/files
ADMINIUM_STORAGE_URL=

# The `s3` leg of the file-driver conformance suite
# (apps/server/test/files-drivers.test.ts). Without it that leg prints
# "SKIPPED (TEST_S3_URL is not set)" by name — it does not vanish, and it does
# not pass. CI runs it against a MinIO service (.github/workflows/ci.yml).
#
# To run it locally:
#   docker run -d --name adminium-minio -p 9000:9000 \
#     -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#     -e MINIO_DEFAULT_BUCKETS=adminium-test bitnami/minio:latest
#   TEST_S3_URL=http://minioadmin:minioadmin@127.0.0.1:9000/adminium-test pnpm --filter @adminium/server test
TEST_S3_URL=

# Optional: a real WebDAV server for the same suite's `webdav` leg. It already
# runs against an in-process stub, so this only adds interop against a real
# target (a NAS, a Hetzner Storage Box, Nextcloud).
#   TEST_WEBDAV_URL=https://user:pass@nas.example.com/remote.php/dav/files/user
TEST_WEBDAV_URL=
