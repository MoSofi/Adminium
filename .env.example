# Local development environment for `pnpm dev`.
#
# Copy to `.env` (gitignored) and fill in. The API server's dev watcher reads
# this file via `node --env-file-if-exists`, so it is optional — if you set
# these in your shell instead, or do not run the server, nothing here is needed.
#
# Production does NOT read this file. Self-hosted deployments pass the same
# variables through the environment; see the self-hosting docs for the full set.

# REQUIRED to start the server. Derives the key that encrypts every stored
# database DSN and API key, so it must stay STABLE — changing it makes anything
# already stored undecryptable. Generate once with:
#   openssl rand -hex 32
ADMINIUM_SECRET=

# Where the meta-store (SQLite by default), uploads and exports live. Defaults
# to a platform data directory; point it somewhere disposable for local work.
ADMINIUM_DATA_DIR=

# Port the API listens on. The dashboard's Vite dev server proxies /api and /ws
# here (apps/dashboard/vite.config.ts), so changing it means setting
# ADMINIUM_DEV_API to match.
PORT=4600
