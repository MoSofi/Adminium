engine-strict=true

# `turbo run dev` starts one `pnpm run dev` per package at once, and pnpm 10's
# pre-run dependency check reads AND rewrites node_modules/.pnpm-workspace-state
# on every one of them. Concurrently, that races: a process reads the file
# mid-write and dies with "Unexpected end of JSON input", taking the whole dev
# session with it (observed on 1 of 2 cold starts). The check only warns about a
# node_modules tree that is stale versus the lockfile — `pnpm install` still
# validates that, and CI installs explicitly.
verify-deps-before-run=false
